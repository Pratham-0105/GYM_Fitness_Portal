{
  "name": "arya-fitness-sms-functions",
  "description": "Firebase Cloud Functions for Arya Fitness Club SMS notifications via 2Factor",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
