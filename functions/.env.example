# =========================================================
# GYM Fitness Portal — Twilio SMS Notification Configuration
# =========================================================

# ── SMS PROVIDER ──────────────────────────────────────────
SMS_PROVIDER=TWILIO

# ── TWILIO CREDENTIALS ────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── GYM DETAILS ───────────────────────────────────────────
GYM_NAME=Arya Fitness Club
ADMIN_TOKEN=arya-admin-token-change-me

# ── SMS MODE ──────────────────────────────────────────────
# mock        → logs SMS, does NOT call Twilio API
# production  → calls real Twilio API and sends real SMS
SMS_MODE=production
