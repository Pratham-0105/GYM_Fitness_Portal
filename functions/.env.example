# =========================================================
# Arya Fitness Club — SMS Notification Environment Variables
# =========================================================
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env to Git.

# ── SMS PROVIDER ──────────────────────────────────────────
SMS_PROVIDER=2FACTOR

# ── 2FACTOR CREDENTIALS ───────────────────────────────────
# Get your API Key from: https://2factor.in → Dashboard → API Key
TWOFACTOR_API_KEY=

# The 6-character Sender ID registered on 2Factor DLT portal
# Example: ARYFIT  (must be exactly 6 uppercase alphabets)
TWOFACTOR_SENDER_ID=ARYFIT

# ── 2FACTOR TEMPLATE NAMES ────────────────────────────────
# These must match the template names EXACTLY as registered
# in your 2Factor account and approved on the DLT portal.
TWOFACTOR_PAYMENT_TEMPLATE_NAME=PAYMENT_SUCCESS
TWOFACTOR_EXPIRING_TEMPLATE_NAME=EXPIRING_SOON
TWOFACTOR_EXPIRED_TEMPLATE_NAME=EXPIRED

# ── GYM DETAILS ───────────────────────────────────────────
GYM_NAME=Arya Fitness Club Shirpur

# ── SMS MODE ──────────────────────────────────────────────
# mock     → logs SMS to Firestore, does NOT call 2Factor API
# production → calls real 2Factor API and sends real SMS
SMS_MODE=mock
